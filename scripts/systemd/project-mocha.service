[Unit]
Description=ProjectMocha — personal AI companion (bridge :8090 + TTS :8092 + web :8080)
Documentation=https://github.com/LofiChptr6/ProjectParrot
# Standalone since 2026-08-02 (split out of the opus trading tree). No coupling
# to trading-desk.target — Mocha's lifecycle is her own. Postgres is her DB.
# NOT gated on var/GPU_HOLD: with the flag present start.sh skips TTS and the
# bridge runs text-only on the remote LLM lane — she stays alive either way.
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
# Wraps start.sh, which launches the uvicorn services with pidfiles.
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/tianyizhang/ProjectMocha
EnvironmentFile=/home/tianyizhang/ProjectMocha/.env
ExecStart=/bin/bash -c 'cd /home/tianyizhang/ProjectMocha && ./start.sh all'
ExecStop=/bin/bash -c 'cd /home/tianyizhang/ProjectMocha && ./start.sh stop'
TimeoutStartSec=600

[Install]
WantedBy=default.target
