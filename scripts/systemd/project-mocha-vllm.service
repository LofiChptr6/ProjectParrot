[Unit]
Description=project mocha — dedicated LLM (Llama-3.2-3B-Instruct on vLLM, GPU)
Documentation=https://github.com/LofiChptr6/ProjectParrot
# Mocha's own small/fast model so she stops sharing opus's 32B (latency + a
# friendlier voice + total inference isolation from the desk). Co-managed with
# the desk; reuses opus's proven .venv-vllm (works on this Blackwell GPU).
After=network-online.target
PartOf=trading-desk.target

[Service]
Type=exec
WorkingDirectory=/home/tianyizhang/opus trading
# HF_TOKEN comes from Mocha's (gitignored) .env — keeps the token out of this unit.
EnvironmentFile=/home/tianyizhang/opus trading/project_mocha/.env
ExecStart=/bin/bash -c 'cd "/home/tianyizhang/opus trading" && exec .venv-vllm/bin/vllm serve unsloth/Llama-3.2-3B-Instruct \
    --gpu-memory-utilization 0.13 \
    --max-model-len 16384 \
    --host 127.0.0.1 \
    --port 8893'
Restart=on-failure
RestartSec=15
TimeoutStartSec=900
StandardOutput=append:/home/tianyizhang/opus trading/project_mocha/logs/vllm-mocha.log
StandardError=append:/home/tianyizhang/opus trading/project_mocha/logs/vllm-mocha.log

[Install]
WantedBy=trading-desk.target
